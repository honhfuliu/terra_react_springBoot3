<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ziheng.system.sysmenu.mapper.SysMenuMapper">

    <resultMap id="BaseResultMap" type="com.ziheng.system.sysmenu.domain.SysMenu">
            <id property="menuId" column="menu_id" jdbcType="BIGINT"/>
            <result property="menuName" column="menu_name" jdbcType="VARCHAR"/>
            <result property="parentId" column="parent_id" jdbcType="BIGINT"/>
            <result property="menuSort" column="menu_sort" jdbcType="INTEGER"/>
            <result property="path" column="path" jdbcType="VARCHAR"/>
            <result property="component" column="component" jdbcType="VARCHAR"/>
            <result property="menuType" column="menu_type" jdbcType="CHAR"/>
            <result property="visible" column="visible" jdbcType="CHAR"/>
            <result property="status" column="status" jdbcType="CHAR"/>
            <result property="perms" column="perms" jdbcType="VARCHAR"/>
            <result property="icon" column="icon" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="CHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        menu_id,menu_name,parent_id,
        menu_sort,path,component,
        menu_type,visible,status,
        perms,icon,create_time,
        update_time,del_flag
    </sql>
    <!-- 根据用户ID查询动态路由菜单(M/C)。
         visible(是否可见)不过滤：隐藏菜单仍需要生成路由（供 URL 直达/详情页），由前端 meta.hidden 控制侧边栏不展示；
         status=0(禁用)、del_flag=1(已删)的菜单不返回；
         递归 CTE 向上补齐祖先节点，避免只分配子菜单、父目录未分配时路由树断裂。 -->
    <select id="findMenuTreeByUserId" resultType="com.ziheng.system.sysmenu.domain.SysMenu">
        WITH RECURSIVE reachable AS (
            SELECT m.*
            FROM sys_menu m
            WHERE m.menu_id IN (
                SELECT rm.menu_id
                FROM sys_role_menu rm
                JOIN sys_user_role ur ON ur.role_id = rm.role_id
                JOIN sys_role r ON r.role_id = rm.role_id
                    AND r.status = '1' AND r.del_flag = '0'
                WHERE ur.user_id = #{userId}
            )
            UNION ALL
            SELECT m.*
            FROM sys_menu m
            JOIN reachable rc ON m.menu_id = rc.parent_id
        )
        SELECT DISTINCT menu_id, menu_name, parent_id, menu_sort, name, path, component,
                        menu_type, visible, status, perms, icon, keep_alive, visible
        FROM reachable
        WHERE menu_type IN ('M', 'C')
          AND status = '1'
          AND del_flag = '0'
        ORDER BY parent_id, menu_sort;
    </select>
    <select id="findPermissionsByUserId" resultType="java.lang.String">
        select distinct perms
        from sys_menu
        where menu_id in
              (select menu_id
               from sys_role_menu
               where role_id in (select sr.role_id
                                 from sys_user_role sur
                                          join sys_role sr on sur.role_id = sr.role_id
                                 where sr.status = '1'
                                   and sr.del_flag = '0'
                                   and sur.user_id = #{userId}))
          and status = '1'
          and menu_type IN ('C', 'F')
          and del_flag = '0';
    </select>
</mapper>
